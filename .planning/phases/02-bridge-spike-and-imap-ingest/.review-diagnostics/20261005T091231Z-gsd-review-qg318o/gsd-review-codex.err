   145	const POLICIES_SQL = `
   146	  select p.polrelid::int as polrelid, p.polname, p.polcmd::text as polcmd, p.polpermissive,
   147	    array(
   148	      select case when o = 0 then 'public' else pg_get_userbyid(o)::text end
   149	      from unnest(p.polroles) as o order by 1
   150	    ) as roles,
   151	    pg_get_expr(p.polqual, p.polrelid) as qual,
   152	    pg_get_expr(p.polwithcheck, p.polrelid) as chk
   153	  from pg_policy p
   154	  order by p.polname`;
