# Mailbox (IMAP) passwords. Copy to .env.mailboxes and fill in:
#
#   cp .env.mailboxes.example .env.mailboxes
#
# Put each Proton Bridge-generated IMAP password here (Bridge shows one per
# account; it is not your Proton account password).
#
# Only the worker container reads this file. Database passwords live in .env.
#
# Add one line per `password_env` in config/config.yaml. The names below match
# config/config.example.yaml.

SIFT_PERSONAL_IMAP_PASSWORD=
SIFT_JOBS_IMAP_PASSWORD=
