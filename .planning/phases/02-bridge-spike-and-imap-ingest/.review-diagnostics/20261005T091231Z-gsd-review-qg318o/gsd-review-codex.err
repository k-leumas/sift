    55	/**
    56	 * Run `fn` in a transaction with app.mailbox_id set transaction-locally, the
    57	 * way the app's withMailbox does. Rolls back and rethrows on error.
    58	 */
    59	async function inScope<T>(
    60	  client: pg.Client,
    61	  mailboxId: string,
    62	  fn: (c: pg.Client) => Promise<T>,
    63	): Promise<T> {
    64	  await client.query('begin');
    65	  try {
    66	    await client.query("select set_config('app.mailbox_id', $1, true)", [mailboxId]);
    67	    const result = await fn(client);
    68	    await client.query('commit');
    69	    return result;
    70	  } catch (error) {
    71	    await client.query('rollback').catch(() => {});
    72	    throw error;
    73	  }
    74	}
