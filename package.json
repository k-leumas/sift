{
  "name": "sift",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">=26.10.0"
  },
  "scripts": {
    "sift": "node --env-file-if-exists=.env.development apps/worker/src/cli.ts",
    "dev": "node --watch --env-file-if-exists=.env.development apps/worker/src/cli.ts worker",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/core/tsconfig.json && tsc -p packages/db/tsconfig.json && tsc -p apps/worker/tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts"
  }
}
