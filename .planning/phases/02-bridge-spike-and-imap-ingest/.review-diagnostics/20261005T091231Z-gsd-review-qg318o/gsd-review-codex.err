Columns this plan adds. TS names in camelCase; bigint columns use { mode: 'number' }:
  message:
    identityKey identity_key text NOT NULL
    messageIdHeader message_id_header text
    internalDate internal_date timestamptz NOT NULL
    sentAt sent_at timestamptz
    fromAddress from_address text
    fromDomain from_domain text
    subject text
    headers jsonb NOT NULL default '{}' ($type<Record<string, string[]>>)
    attachments jsonb NOT NULL default '[]' ($type<{ name: string | null; mimeType: string; sizeBytes: number | null }[]>)
    sizeBytes size_bytes bigint
    eligibleForClassification eligible_for_classification boolean NOT NULL
    unique message_mailbox_id_identity_key_key (mailbox_id, identity_key)
    check message_identity_key_check: identity_key ~ '^(pm|mid|hdr):.+'
  message_location (new):
    id uuid pk default uuidv7(), mailbox_id, message_id uuid NOT NULL,
    folder text NOT NULL, uidvalidity bigint NOT NULL, uid bigint NOT NULL,
    generation integer NOT NULL, removed_at timestamptz, removed_reason text, timestamps
    unique message_location_mailbox_id_id_key; unique message_location_mailbox_id_folder_uidvalidity_uid_key
    FK message_location_message_fk; index message_location_message_idx (mailbox_id, message_id)
    check message_location_removed_check:
      (removed_at is null and removed_reason is null) or (removed_at is not null and removed_reason in ('vanished','superseded'))
  message_body (new):
    id, mailbox_id, message_id NOT NULL, body_text text NOT NULL, source text NOT NULL,
    truncated boolean NOT NULL, expires_at timestamptz, timestamps
    unique message_body_mailbox_id_id_key; unique message_body_mailbox_id_message_id_key; FK message_body_message_fk
    check message_body_source_check: source in ('text_plain','text_html','none')
    index message_body_expires_at_idx (expires_at)
  folder_sync (add):
    folder text NOT NULL, uidvalidity bigint NOT NULL, last_uid bigint NOT NULL,
    internal_date_watermark timestamptz NOT NULL, generation integer NOT NULL default 1,
    state text NOT NULL default 'ok', pending_uidvalidity bigint, pending_generation integer,
    last_resync_at timestamptz,
    last_resync_summary jsonb ($type<{ matched: number; new: number; gone: number; older: number }>)
    backfill_since timestamptz, backfill_cursor_uid bigint, backfill_until_uid bigint, backfill_total integer   (D-75 first backfill, null when none is pending)
    unique folder_sync_mailbox_id_folder_key; check folder_sync_state_check: state in ('ok','resyncing')
    check folder_sync_pending_check: (state = 'resyncing') = (pending_uidvalidity is not null and pending_generation is not null)
    check folder_sync_backfill_check: the four backfill columns are all null or all not null
  mailbox_status (change):
    mailbox_status_state_check: state in ('ok','error','disabled','connecting','needs_attention')
    + held_new_count integer, approved_new_count integer, backfill_done integer, backfill_total integer
    check mailbox_status_held_check: state <> 'needs_attention' or held_new_count is not null
    check mailbox_status_backfill_check: (backfill_done is null) = (backfill_total is null)

Scope additions: messageLocation: ScopedTableApi<typeof messageLocation>; messageBody: ScopedTableApi<typeof messageBody>
