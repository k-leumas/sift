    57	      SIFT_BACKUP_DATABASE_URL: postgres://sift_backup:${SIFT_DB_BACKUP_PASSWORD:?set in .env}@db:5432/sift
    58	      SIFT_DB_APP_PASSWORD: ${SIFT_DB_APP_PASSWORD:?set in .env}
