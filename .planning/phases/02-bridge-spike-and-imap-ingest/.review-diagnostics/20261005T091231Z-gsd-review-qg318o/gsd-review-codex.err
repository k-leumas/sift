     4	
     5	/** Exit code for usage errors (no command, unknown command). */
     6	const EXIT_USAGE = 2;
     7	
     8	export function usage(): string {
     9	  const width = Math.max(...COMMANDS.map((c) => c.usage.length));
    10	  const lines = COMMANDS.map((c) => `  ${c.usage.padEnd(width)}  ${c.summary}`);
    11	  return [
    12	    'Usage: sift <command> [options]',
    13	    '',
    14	    'Commands:',
    15	    ...lines,
    16	    '',
    17	    `Config file: config/config.yaml (override with SIFT_CONFIG). Supported config version: ${SUPPORTED_CONFIG_VERSION}`,
    18	  ].join('\n');
    19	}
    20	
    21	/** Pick the command whose path is the longest prefix of the leading positionals. */
    22	function matchCommand(positionals: readonly string[]): CommandSpec | undefined {
    23	  let best: CommandSpec | undefined;
    24	  for (const spec of COMMANDS) {
    25	    const fits =
    26	      spec.path.length <= positionals.length && spec.path.every((w, i) => positionals[i] === w);
    27	    if (fits && (best === undefined || spec.path.length > best.path.length)) {
    28	      best = spec;
    29	    }
    30	  }
    31	  return best;
    32	}
    33	
    34	export async function main(argv: readonly string[], io: CommandIO): Promise<number> {
    35	  const { values, tokens } = parseArgs({
    36	    args: [...argv],
    37	    options: { help: { type: 'boolean', short: 'h' } },
    38	    strict: false,
    39	    allowPositionals: true,
    40	    tokens: true,
    41	  });
    42	
    43	  // Leading positionals select the command; everything after them belongs to it.
    44	  const leading: string[] = [];
    45	  for (const token of tokens) {
    46	    if (token.kind !== 'positional') break;
    47	    leading.push(token.value);
    48	  }
    49	
    50	  if (values.help === true || leading[0] === 'help') {
    51	    io.stdout(usage());
    52	    return 0;
    53	  }
    54	
    55	  if (argv.length === 0) {
    56	    io.stderr(usage());
    57	    return EXIT_USAGE;
    58	  }
    59	
    60	  const spec = matchCommand(leading);
    61	  if (spec === undefined) {
    62	    const words = leading.length > 0 ? leading.join(' ') : argv.join(' ');
    63	    io.stderr(`Unknown command: ${words}. Run "sift --help".`);
    64	    return EXIT_USAGE;
    65	  }
    66	
    67	  try {
    68	    const command = await loadCommand(spec);
    69	    return await command.run(argv.slice(spec.path.length), io);
    70	  } catch (error) {
    71	    const message = error instanceof Error ? error.message : String(error);
    72	    io.stderr(`sift: ${message}`);
    73	    return 1;
    74	  }
    75	}
    76	
    77	if (import.meta.main) {
    78	  const io: CommandIO = {
    79	    env: process.env,
    80	    cwd: process.cwd(),
    81	    stdout: (line) => process.stdout.write(`${line}\n`),
    82	    stderr: (line) => process.stderr.write(`${line}\n`),
    83	  };
    84	  // Set exitCode instead of calling process.exit so buffered output is flushed.
    85	  process.exitCode = await main(process.argv.slice(2), io);
    86	}

