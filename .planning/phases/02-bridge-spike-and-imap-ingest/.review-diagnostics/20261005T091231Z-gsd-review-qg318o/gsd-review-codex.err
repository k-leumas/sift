    81	const RELATIONS_SQL = `
    82	  select c.oid::int as oid,
    83	    n.nspname || '.' || c.relname as qualified,
    84	    c.relkind::text as relkind,
    85	    c.relrowsecurity as rls,
    86	    c.relforcerowsecurity as force,
    87	    (select a.attnotnull from pg_attribute a
    88	      where a.attrelid = c.oid and a.attname = 'mailbox_id' and not a.attisdropped
    89	    ) as mailbox_id_notnull,
    90	    exists (
    91	      select 1 from pg_constraint k
    92	        join pg_attribute a on a.attrelid = k.conrelid and a.attnum = any(k.conkey)
    93	      where k.conrelid = c.oid and k.contype = 'f'
    94	        and k.confrelid = 'public.mailbox'::regclass
    95	        and a.attname = 'mailbox_id' and array_length(k.conkey, 1) = 1
    96	    ) as fk_to_mailbox,
    97	    exists (
    98	      select 1 from pg_constraint k
    99	      where k.conrelid = c.oid and k.contype in ('u', 'p')
   100	        and array(
   101	          select a.attname::text
   102	          from unnest(k.conkey) with ordinality as u(attnum, ord)
   103	            join pg_attribute a on a.attrelid = c.oid and a.attnum = u.attnum
   104	          order by u.ord
   105	        ) = array['mailbox_id', 'id']
   106	    ) as unique_mailbox_id_id,
   107	    (select array(
   108	        select a.attname::text
   109	        from unnest(k.conkey) with ordinality as u(attnum, ord)
   110	          join pg_attribute a on a.attrelid = c.oid and a.attnum = u.attnum
   111	        order by u.ord)
   112	      from pg_constraint k where k.conrelid = c.oid and k.contype = 'p'
   113	    ) as pk_columns,
   114	    exists (
   115	      select 1 from pg_attribute a
   116	      where a.attrelid = c.oid and a.attname = 'updated_at' and not a.attisdropped
   117	    ) as has_updated_at,
   118	    exists (
   119	      select 1 from pg_trigger t join pg_proc f on f.oid = t.tgfoid
   120	      where t.tgrelid = c.oid and not t.tgisinternal and t.tgenabled <> 'D'
   121	        and (t.tgtype::int & 1) = 1    -- FOR EACH ROW
   122	        and (t.tgtype::int & 2) = 2    -- BEFORE
   123	        and (t.tgtype::int & 16) = 16  -- UPDATE
   124	        and f.proname = 'set_updated_at'
   125	    ) as updated_at_trigger,
   126	    -- has_any_column_privilege: true for a table-level grant and for a grant on
   127	    -- any single column, which has_table_privilege does not see.
   128	    has_any_column_privilege('sift_app', c.oid, 'SELECT') as app_select,
   129	    has_any_column_privilege('sift_app', c.oid, 'INSERT') as app_insert,
   130	    has_any_column_privilege('sift_app', c.oid, 'UPDATE') as app_update,
   131	    has_table_privilege('sift_app', c.oid, 'DELETE') as app_delete,
   132	    has_table_privilege('sift_app', c.oid, 'TRUNCATE') as app_truncate,
   133	    has_table_privilege('sift_app', c.oid, 'REFERENCES') as app_references,
   134	    has_table_privilege('sift_app', c.oid, 'TRIGGER') as app_trigger,
   135	    has_any_column_privilege('sift_backup', c.oid, 'INSERT') as backup_insert,
   136	    has_any_column_privilege('sift_backup', c.oid, 'UPDATE') as backup_update,
   137	    has_table_privilege('sift_backup', c.oid, 'DELETE') as backup_delete,
   138	    has_table_privilege('sift_backup', c.oid, 'TRUNCATE') as backup_truncate
   139	  from pg_class c join pg_namespace n on n.oid = c.relnamespace
   140	  where c.relkind in ('r', 'p', 'v', 'm', 'f')
   141	    and n.nspname not in ('pg_catalog', 'information_schema')
   142	    and n.nspname not like 'pg_toast%'
   143	  order by 2`;
