   156	/** Every FK, with whether some position pairs mailbox_id with mailbox_id (D-04). */
   157	const FOREIGN_KEYS_SQL = `
   158	  select k.conname,
   159	    cn.nspname || '.' || cc.relname as child,
   160	    pn.nspname || '.' || pc.relname as parent,
   161	    exists (
   162	      select 1 from generate_subscripts(k.conkey, 1) as i
   163	        join pg_attribute ca on ca.attrelid = k.conrelid and ca.attnum = k.conkey[i]
   164	        join pg_attribute pa on pa.attrelid = k.confrelid and pa.attnum = k.confkey[i]
   165	      where ca.attname = 'mailbox_id' and pa.attname = 'mailbox_id'
   166	    ) as mailbox_aligned
   167	  from pg_constraint k
   168	    join pg_class cc on cc.oid = k.conrelid
   169	    join pg_namespace cn on cn.oid = cc.relnamespace
   170	    join pg_class pc on pc.oid = k.confrelid
   171	    join pg_namespace pn on pn.oid = pc.relnamespace
   172	  where k.contype = 'f'
   173	  order by 2, 1`;
