    32	  imapPort: number;
    33	  imapUsername: string;
    34	  imapFolder: string;
    35	  passwordEnv: string;
    36	  labelsApplyAs: string;
    37	}
    38	
    39	export type RegistryChange =
    40	  | { kind: 'add'; slug: string; values: MailboxValues }
    41	  | { kind: 'update'; slug: string; changes: FieldChange[] }
    42	  | { kind: 'enable'; slug: string; changes: FieldChange[] }
    43	  | { kind: 'disable'; slug: string };
    44	
    45	export type RegistryRowLike = Pick<
    46	  MailboxRow,
    47	  | 'slug'
    48	  | 'displayName'
    49	  | 'imapHost'
    50	  | 'imapPort'
    51	  | 'imapUsername'
    52	  | 'imapFolder'
    53	  | 'passwordEnv'
    54	  | 'labelsApplyAs'
    55	  | 'disabledAt'
    56	>;
    57	
    58	/** Registry column -> MailboxValues key, in the order changes are reported. */
    59	const FIELDS: readonly (readonly [RegistryField, Exclude<keyof MailboxValues, 'slug'>])[] = [
    60	  ['display_name', 'displayName'],
    61	  ['imap_host', 'imapHost'],
    62	  ['imap_port', 'imapPort'],
    63	  ['imap_username', 'imapUsername'],
    64	  ['imap_folder', 'imapFolder'],
    65	  ['password_env', 'passwordEnv'],
    66	  ['labels_apply_as', 'labelsApplyAs'],
    67	];
    68	
    69	export function mailboxValuesFromConfig(m: MailboxConfig): MailboxValues {
    70	  return {
    71	    slug: m.slug,
    72	    displayName: m.display_name ?? null,
    73	    imapHost: m.imap.host,
    74	    imapPort: m.imap.port,
    75	    imapUsername: m.imap.username,
    76	    imapFolder: m.imap.folder,
    77	    passwordEnv: m.imap.password_env,
    78	    labelsApplyAs: m.labels.apply_as,
    79	  };
    80	}
    81	
    82	function fieldChanges(row: RegistryRowLike, values: MailboxValues): FieldChange[] {
    83	  const changes: FieldChange[] = [];
    84	  for (const [field, key] of FIELDS) {
    85	    const from = row[key];
    86	    const to = values[key];
    87	    if (from !== to) changes.push({ field, from, to });
    88	  }
    89	  return changes;
    90	}
    91	
    92	/**
    93	 * Changes that make the registry match config. Config entries come first in
    94	 * config order (add, update or enable), then disables in slug order. Rows that
    95	 * are already disabled and absent from config produce nothing. An empty result
    96	 * means the registry matches config.
    97	 */
    98	export function planRegistryChanges(
    99	  config: SiftConfig,
   100	  rows: readonly RegistryRowLike[],
   101	): RegistryChange[] {
   102	  const bySlug = new Map(rows.map((row) => [row.slug, row]));
   103	  const configured = new Set<string>();
   104	  const changes: RegistryChange[] = [];
   105	
   106	  for (const mailbox of config.mailboxes) {
   107	    const values = mailboxValuesFromConfig(mailbox);
   108	    configured.add(values.slug);
   109	    const row = bySlug.get(values.slug);
   110	    if (row === undefined) {
   111	      changes.push({ kind: 'add', slug: values.slug, values });
   112	      continue;
   113	    }
   114	    const diff = fieldChanges(row, values);
   115	    if (row.disabledAt !== null) {
   116	      changes.push({ kind: 'enable', slug: values.slug, changes: diff });
   117	    } else if (diff.length > 0) {
   118	      changes.push({ kind: 'update', slug: values.slug, changes: diff });
   119	    }
   120	  }
   121	
   122	  const removed = rows
   123	    .filter((row) => !configured.has(row.slug) && row.disabledAt === null)
   124	    .map((row) => row.slug)
   125	    .sort();
   126	  for (const slug of removed) changes.push({ kind: 'disable', slug });
   127	
   128	  return changes;
   129	}
   130	
   131	/** A rename the owner can run: the removed slug and the added slug it likely became. */
   132	export interface RenamePair {
   133	  from: string;
   134	  to: string;
   135	  /**
   136	   * Set on the lone pair (one removed, one added) when the registry row's IMAP
   137	   * host, username or folder differ from the new entry's: it may be a
   138	   * different account, not a rename (IN-09).
   139	   */
   140	  identityDiffers?: true;
   141	}
   142	
   143	export interface RenameSuspects {
   144	  /** Enabled slugs no longer in config, in slug order. */
   145	  removed: string[];
   146	  /** New config slugs, in config order. */
   147	  added: string[];
   148	  /**
   149	   * Removed -> added pairs safe to suggest as `sift mailbox rename`. One
   150	   * removed next to one added is paired as is (D-33), flagged with
   151	   * identityDiffers when their IMAP identity is known to differ. With more than one on
   152	   * either side, slugs are paired only by IMAP identity (host, username,
   153	   * folder), which a real rename keeps, and only when the match is unique both
   154	   * ways. Anything else is left unpaired rather than guessed: following a
   155	   * wrong pair would attach one account's history to another.
   156	   */
   157	  pairs: RenamePair[];
   158	}
   159	
   160	/**
   161	 * A slug that disappears while another appears in the same apply may be a
   162	 * rename typed into config.yaml (D-33). Returns the suspects when there is at
   163	 * least one disable and at least one add, otherwise null. `rows` are the
   164	 * registry rows the changes were planned from; they supply the removed slugs'
   165	 * IMAP identity.
   166	 */
   167	export function findRenameSuspects(
   168	  changes: readonly RegistryChange[],
   169	  rows: readonly RegistryRowLike[] = [],
   170	): RenameSuspects | null {
   171	  const removed = changes.filter((c) => c.kind === 'disable').map((c) => c.slug);
   172	  const adds = changes.flatMap((c) => (c.kind === 'add' ? [c] : []));
   173	  const added = adds.map((c) => c.slug);
   174	  if (removed.length === 0 || added.length === 0) return null;
   175	
   176	  const [onlyRemoved] = removed;
   177	  const [onlyAdd] = adds;
   178	  if (removed.length === 1 && adds.length === 1 && onlyRemoved && onlyAdd) {
   179	    const pair: RenamePair = { from: onlyRemoved, to: onlyAdd.slug };
   180	    const row = rows.find((r) => r.slug === onlyRemoved);
   181	    const { imapHost, imapUsername, imapFolder } = onlyAdd.values;
   182	    if (
   183	      row !== undefined &&
   184	      imapIdentityKey(row.imapHost, row.imapUsername, row.imapFolder) !==
   185	        imapIdentityKey(imapHost, imapUsername, imapFolder)
   186	    ) {
   187	      pair.identityDiffers = true;
   188	    }
   189	    return { removed, added, pairs: [pair] };
   190	  }
   191	
   192	  const addedByKey = new Map<string, string[]>();
   193	  for (const { slug, values } of adds) {
   194	    const key = imapIdentityKey(values.imapHost, values.imapUsername, values.imapFolder);
   195	    addedByKey.set(key, [...(addedByKey.get(key) ?? []), slug]);
   196	  }
   197	  const removedKeys = new Map<string, string[]>();
   198	  const keyOf = new Map<string, string>();
   199	  for (const slug of removed) {
   200	    const row = rows.find((r) => r.slug === slug);
   201	    if (row === undefined) continue;
   202	    const key = imapIdentityKey(row.imapHost, row.imapUsername, row.imapFolder);
   203	    keyOf.set(slug, key);
   204	    removedKeys.set(key, [...(removedKeys.get(key) ?? []), slug]);
   205	  }
   206	  const pairs: RenamePair[] = [];
   207	  for (const from of removed) {
   208	    const key = keyOf.get(from);
   209	    if (key === undefined) continue;
   210	    const candidates = addedByKey.get(key) ?? [];
   211	    const [to] = candidates;
   212	    if (to !== undefined && candidates.length === 1 && removedKeys.get(key)?.length === 1) {
   213	      pairs.push({ from, to });
   214	    }
   215	  }
   216	  return { removed, added, pairs };
   217	}
   218	
   219	function formatValue(value: string | number | null): string {
   220	  if (value === null) return '(none)';
   221	  return typeof value === 'number' ? String(value) : JSON.stringify(value);
   222	}
   223	
   224	function formatChanges(changes: readonly FieldChange[]): string {
   225	  return changes.map((c) => `${c.field} ${formatValue(c.from)} -> ${formatValue(c.to)}`).join(', ');
   226	}
   227	
   228	/** One line per change for the owner. Values are registry data, never secrets. */
   229	export function describeChange(change: RegistryChange): string {
   230	  switch (change.kind) {
   231	    case 'add':
   232	      return `add mailbox "${change.slug}"`;
   233	    case 'update':
   234	      return `update mailbox "${change.slug}": ${formatChanges(change.changes)}`;
   235	    case 'enable':
   236	      return change.changes.length === 0
   237	        ? `re-enable mailbox "${change.slug}"`
   238	        : `re-enable mailbox "${change.slug}": ${formatChanges(change.changes)}`;
   239	    case 'disable':
   240	      return `disable mailbox "${change.slug}" (no longer in config.yaml; its data is kept)`;

