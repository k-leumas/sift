    63	      # Must be writable by uid 1000 (the image's node user).
    64	      # SIFT_BACKUP_HOST_DIR exists only so scripts/compose-smoke.sh keeps its
    65	      # throwaway dumps out of your ./backups; leave it unset.
    66	      - ${SIFT_BACKUP_HOST_DIR:-./backups}:/backups
