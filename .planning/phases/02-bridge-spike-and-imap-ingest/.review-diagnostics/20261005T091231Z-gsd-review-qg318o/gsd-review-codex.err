   255	export async function withMailbox<T>(
   256	  db: AppDb,
   257	  mailboxId: string,
   258	  fn: (scope: Scope) => Promise<T>,
   259	  options: WithMailboxOptions = {},
   260	): Promise<T> {
   261	  if (typeof mailboxId !== 'string' || !UUID.test(mailboxId)) {
   262	    throw new InvalidMailboxIdError();
   263	  }
   264	  const { orm } = internalsOf(db);
   265	  return orm.transaction(async (tx) => {
   266	    await tx.execute(sql`select set_config('app.mailbox_id', ${mailboxId}, true)`);
   267	    let open = true;
   268	    const ctx: ScopeContext = {
   269	      tx,
   270	      mailboxId,
   271	      assertOpen() {
   272	        if (!open) throw new ScopeClosedError();
   273	      },
   274	    };
   275	    const scope: Scope = Object.freeze({
   276	      mailboxId,
   277	      message: scopedTable(ctx, message),
   278	      label: scopedTable(ctx, label),
   279	      folderSync: scopedTable(ctx, folderSync),
   280	      ruleSet: scopedTable(ctx, ruleSet),
   281	      decision: appendOnlyTable(ctx, decision),
   282	      labelEvent: appendOnlyTable(ctx, labelEvent),
   283	      mailboxStatus: mailboxStatusApi(ctx),
   284	    });
   285	    contexts.set(scope, ctx);
   286	    try {
   287	      if (options.requireActive === true) await requireActive(scope);
   288	      return await fn(scope);
   289	    } finally {
   290	      open = false;
   291	    }
   292	  });
   293	}

