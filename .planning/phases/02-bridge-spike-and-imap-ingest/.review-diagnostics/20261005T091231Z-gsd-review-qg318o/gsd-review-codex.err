     1	# Sift stack: db -> setup (one-shot) -> worker.
     2	#
     3	# Before the first `docker compose up -d`, copy the three example files:
     4	#   .env.example                -> .env             (database passwords)
     5	#   .env.mailboxes.example      -> .env.mailboxes   (mailbox IMAP passwords)
     6	#   config/config.example.yaml  -> config/config.yaml
     7	#
     8	# Each service receives only the secrets it needs: the worker connects as
     9	# sift_app and reads mailbox passwords; setup holds the owner and backup
    10	# credentials but never a mailbox password.
    11	#
    12	# No top-level `name:` and no healthcheck `start_interval`: the dev machine
    13	# runs Docker Compose v2.2.3.
    14	#
    15	# SIFT_IMAGE, SIFT_CONFIG_HOST_DIR, SIFT_MAILBOXES_ENV_FILE, SIFT_BACKUP_HOST_DIR
    16	# and SIFT_PGDATA_VOLUME exist only so scripts/compose-smoke.sh can run a
    17	# throwaway stack that shares none of your files, image or volume. Leave them
    18	# unset.
    19	
    20	services:
    21	  db:
    22	    image: pgvector/pgvector:0.8.7-pg18-trixie
    23	    environment:
    24	      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set in .env}
    25	      SIFT_DB_OWNER_PASSWORD: ${SIFT_DB_OWNER_PASSWORD:?set in .env}
    26	      SIFT_DB_BACKUP_PASSWORD: ${SIFT_DB_BACKUP_PASSWORD:?set in .env}
    27	    volumes:
    28	      # PG18 images keep PGDATA under /var/lib/postgresql/18/docker; mount the
    29	      # parent, not .../data, or the data lands in an anonymous volume.
    30	      - sift-pgdata:/var/lib/postgresql
    31	      - ./db/bootstrap.sql:/docker-entrypoint-initdb.d/10-sift-bootstrap.sql:ro
    32	    healthcheck:
    33	      # TCP, not the unix socket: the temporary initdb server listens on no
    34	      # TCP address, so it never reads as healthy while bootstrap runs.
    35	      test: ["CMD-SHELL", "pg_isready -h 127.0.0.1 -U postgres -d sift"]
    36	      interval: 5s
    37	      timeout: 3s
    38	      retries: 20
    39	      start_period: 10s
    40	    ports:
    41	      # Loopback only. Never publish Postgres on all interfaces.
    42	      - "127.0.0.1:${SIFT_DB_PORT:-5432}:5432"
    43	    restart: unless-stopped
    44	
    45	  # `sift setup`: config check, migrate (with a pg_dump backup first), config
    46	  # apply. Rerun after editing config/config.yaml: docker compose run --rm setup
    47	  setup:
    48	    build:
    49	      context: .
