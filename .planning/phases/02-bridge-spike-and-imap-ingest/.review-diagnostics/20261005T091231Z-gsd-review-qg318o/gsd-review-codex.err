   199	/** created_at of the newest applied migration (drizzle's own rule), or null when none. */
   200	async function lastAppliedMillis(client: pg.Client): Promise<number | null> {
   201	  const table = `${MIGRATIONS_SCHEMA}.${MIGRATIONS_TABLE}`;
   202	  const exists = await client.query<{ present: boolean }>(
   203	    'select to_regclass($1) is not null as present',
   204	    [table],
   205	  );
   206	  if (!exists.rows[0]?.present) {
   207	    return null;
   208	  }
   209	  const result = await client.query<{ created_at: string | null }>(
   210	    `select created_at from "${MIGRATIONS_SCHEMA}"."${MIGRATIONS_TABLE}" order by created_at desc limit 1`,
   211	  );
   212	  const value = result.rows[0]?.created_at;
   213	  return value === undefined || value === null ? null : Number(value);
   214	}
