capture.ts (this plan; the ONLY file under apps/worker/src that turns certificate verification off, and only for this handshake, per D-80):
  export interface CapturedCertificate { pem: string; spkiSha256: string; validTo: string; subject: string }
  export async function capturePeerCertificate(opts: { host: string; port: number; mode: 'starttls' | 'implicit'; timeoutMs?: number }): Promise<CapturedCertificate>;
    // starttls: plain TCP, read the greeting.
    //   - Greeting carries a capability code without STARTTLS: reject with an Error of code SIFT_NO_STARTTLS, having written nothing.
    //   - Otherwise write exactly one line, `<tag> STARTTLS`. A tagged NO or BAD rejects with SIFT_NO_STARTTLS.
    //   - On the tagged OK, upgrade with tls.connect({ socket, servername (hostnames only) }) with verification off, read getPeerCertificate(true).raw, destroy the socket.
    //   - Nothing else is ever written: no CAPABILITY, no ID, no LOGOUT, no login command, no credential.
    // implicit: tls.connect directly with verification off; read the certificate on 'secureConnect', destroy the socket; nothing is written.
    // Every call is a fresh handshake. Nothing is cached in module state and nothing is written to disk (D-80).

connect.ts (this plan):
  export interface BridgeConnectOptions { host: string; port: number; user: string; pass: string;
    tls: { mode: 'starttls' | 'implicit'; pinSha256?: string }; connectTimeoutMs?: number; disableAutoEnable?: boolean }
  export class PinMismatchError extends Error { readonly code = 'SIFT_TLS_PIN_MISMATCH'; readonly seen: string }   // seen = fingerprint the server presented
  export type ImapErrorClass = 'unreachable' | 'timeout' | 'auth_rejected' | 'pin_mismatch' | 'cert_untrusted' | 'no_starttls' | 'protocol';
  export async function openImap(opts: BridgeConnectOptions, deps?: { createClient?: (o: ImapFlowOptions) => ImapFlow; capture?: typeof capturePeerCertificate }): Promise<ImapFlow>;   // connected and authenticated
  export async function closeImap(client: ImapFlow): Promise<void>;     // logout bounded by 5 s, then close; never throws
  export function classifyImapError(error: unknown): ImapErrorClass;
  export type { ImapFlow } from 'imapflow';

ImapFlow facts (Context7 /websites/imapflow and RESEARCH, imapflow 2.1.0):
  options: host, port, secure, doSTARTTLS, auth {user, pass}, logger (false disables pino output), tls (merged into tls.connect, for the implicit connection and the STARTTLS upgrade),
  clientInfo, disableAutoIdle, disableAutoEnable, connectionTimeout, greetingTimeout, socketTimeout.
  errors: err.authenticationFailed (bad credentials), err.code ('NoConnection', 'EConnectionClosed', socket codes), err.responseStatus ('NO' / 'BAD').
  doSTARTTLS: true throws before any login when the server does not advertise STARTTLS (check its exact error message/code in dist/esm/imap-flow.js).
  Node calls tls checkServerIdentity only after the chain verifies; a self-signed certificate therefore needs `ca` (RESEARCH Pattern 4 probe table).

fake-imap-server.ts (this plan; test support):
  export interface TestCertificate { pem: string; key: string; spkiSha256: string }
  export async function makeTestCertificates(): Promise<{ captured: TestCertificate; unrelated: TestCertificate; issuedByCaptured: TestCertificate }>;
    // openssl via execFile into a mkdtemp dir. `captured` and `unrelated` are self-signed with basicConstraints critical CA:TRUE and keyUsage keyCertSign,digitalSignature
    // (shaped like Bridge's and the test server's certificates); `issuedByCaptured` is a leaf signed with captured's key.
  export interface FakeConnection { plaintextLines: string[]; tlsBytes: Buffer; upgraded: boolean; closed: boolean }
  export async function startFakeImapServer(opts: { mode: 'plain' | 'starttls' | 'implicit'; greeting?: string; certificates?: TestCertificate[]; starttlsReply?: 'OK' | 'BAD' }):
    Promise<{ port: number; connections(): FakeConnection[]; close(): Promise<void> }>;
    // A net.Server on 127.0.0.1:0. Connection i uses certificates[i] (the last one repeats).
    // plain: never upgrades; default greeting `* OK [CAPABILITY IMAP4rev1 AUTH=PLAIN] fake ready` (no STARTTLS).
    // starttls: default greeting `* OK [CAPABILITY IMAP4rev1 STARTTLS AUTH=PLAIN] fake ready`; answers STARTTLS with `<tag> OK begin TLS` (or BAD),
    //           then wraps the socket in new tls.TLSSocket(socket, { isServer: true, key, cert }).
    // implicit: wraps the socket in a server TLSSocket at once and greets after the handshake.
    // Records every plaintext line before the upgrade and every decrypted byte after it; answers `<tag> OK done` to any other tagged line;
    // calls resume() on every socket (cerebrum: a socket without a data reader never sees the peer's FIN).
</interfaces>
</context>

