<task type="tracer">
  <name>Task 1: Tracer - nudge() makes an idle mailbox run now, through the real tick loop</name>
  <files>apps/worker/src/runtime/supervisor.ts, apps/worker/test/supervisor.test.ts</files>
  <read_first>
    - apps/worker/src/runtime/supervisor.ts (whole file: runMailbox, schedule, wakeAt, nextTickAt, stop)
