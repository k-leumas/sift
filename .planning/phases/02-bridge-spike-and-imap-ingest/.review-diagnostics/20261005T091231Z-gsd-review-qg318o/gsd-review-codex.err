   123	function matchConditions(table: ScopedTable, match: object | undefined): SQL[] {
   124	  if (match === undefined) return [];
   125	  const columns: Record<string, PgColumn> = getTableColumns(table);
   126	  const conditions: SQL[] = [];
   127	  for (const [key, value] of Object.entries(match)) {
   128	    if (value === undefined) continue;
   129	    const column = columns[key];
   130	    if (column === undefined || key === 'mailboxId') {
   131	      throw new TypeError(`Cannot match on "${key}"`);
   132	    }
   133	    conditions.push(value === null ? isNull(column) : eq(column, value));
   134	  }
   135	  return conditions;
   136	}
   137	
   138	function definedEntries(values: object): Record<string, unknown> {
   139	  return Object.fromEntries(Object.entries(values).filter(([, v]) => v !== undefined));
   140	}
   141	
   142	/**
   143	 * The generic helper behind every scoped table (D-43): inserts are filled
   144	 * with the scope's mailbox, and every read or write adds
   145	 * `mailbox_id = scope.mailboxId` itself, independently of RLS.
   146	 */
   147	function scopedTable<T extends ScopedTable>(ctx: ScopeContext, table: T): ScopedTableApi<T> {
   148	  const { tx, mailboxId } = ctx;
   149	  const where = (match: object | undefined): SQL | undefined =>
   150	    and(eq(table.mailboxId, mailboxId), ...matchConditions(table, match));
   151	  // Drizzle's builders do not narrow over a generic table; the public
   152	  // ScopedTableApi<T> signature is what callers are held to.
   153	  const anyTable = table as unknown as PgTable;
   154	
   155	  return Object.freeze({
   156	    async insert(rows: readonly object[]) {
   157	      ctx.assertOpen();
   158	      if (rows.length === 0) return [];
   159	      const values = rows.map((row) => ({ ...definedEntries(row), mailboxId }));
   160	      return (await tx
   161	        .insert(anyTable)
   162	        .values(values as never)
   163	        .returning()) as InferSelectModel<T>[];
   164	    },
   165	    async find(match?: object) {
   166	      ctx.assertOpen();
   167	      return (await tx.select().from(anyTable).where(where(match))) as InferSelectModel<T>[];
   168	    },
   169	    async update(set: object, match?: object) {
   170	      ctx.assertOpen();
   171	      const values = definedEntries(set);
   172	      for (const key of Object.keys(values)) {
   173	        if (FORBIDDEN_SET_KEYS.has(key)) throw new TypeError(`Cannot update "${key}"`);
   174	      }
   175	      // An empty set still runs (touching updated_at through the trigger).
   176	      const assignments =
   177	        Object.keys(values).length > 0 ? values : { mailboxId: sql`${table.mailboxId}` };
   178	      return (await tx
   179	        .update(anyTable)
   180	        .set(assignments as never)
   181	        .where(where(match))
   182	        .returning()) as InferSelectModel<T>[];
   183	    },
   184	    async delete(match?: object) {
   185	      ctx.assertOpen();
   186	      return (await tx.delete(anyTable).where(where(match)).returning()) as InferSelectModel<T>[];
   187	    },
   188	  }) as ScopedTableApi<T>;
   189	}
   190	
