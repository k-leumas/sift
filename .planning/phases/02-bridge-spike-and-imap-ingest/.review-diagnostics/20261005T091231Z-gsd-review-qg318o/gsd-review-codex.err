  <name>Task 1: Tracer - openImap logs in to the test server through the capture, the pin comparison and a login connection verified twice</name>
  <files>apps/worker/src/imap/capture.ts, apps/worker/src/imap/connect.ts, apps/worker/test/imap-connect.test.ts</files>
  <read_first>
    - apps/worker/src/imap/pin.ts and apps/worker/test/support/test-imap.ts (02-04)
