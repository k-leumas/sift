    45	 * one transaction under app.mailbox_id (the owner is subject to FORCE RLS,
    46	 * D-41). Safe to call repeatedly for the same mailbox.
    47	 */
    48	export async function seedScopedRows(ownerUrl: string, mailboxId: string): Promise<ScopedRowIds> {
    49	  const owner = await connect(ownerUrl);
    50	  try {
    51	    await owner.query('begin');
    52	    await owner.query("select set_config('app.mailbox_id', $1, true)", [mailboxId]);
    53	
    54	    const insertId = async (sql: string, params: unknown[]): Promise<string> => {
    55	      const { rows } = await owner.query<{ id: string }>(sql, params);
    56	      const id = rows[0]?.id;
    57	      if (id === undefined) {
    58	        throw new Error(`seedScopedRows: no id returned by: ${sql}`);
    59	      }
    60	      return id;
    61	    };
    62	
    63	    const messageId = await insertId('insert into message (mailbox_id) values ($1) returning id', [
    64	      mailboxId,
    65	    ]);
    66	    const labelId = await insertId(
    67	      'insert into label (mailbox_id, message_id) values ($1, $2) returning id',
    68	      [mailboxId, messageId],
