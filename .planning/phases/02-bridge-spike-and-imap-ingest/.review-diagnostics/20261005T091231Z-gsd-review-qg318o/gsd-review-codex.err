   151	  } finally {
   152	    try {
   153	      if (locked) {
   154	        await client.query('select pg_advisory_unlock($1)', [MIGRATE_LOCK_KEY]);
   155	      }
   156	    } finally {
   157	      await client.end();
   158	    }
   159	  }
