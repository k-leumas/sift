   175	/**
   176	 * Read pg_catalog and return every violation of the isolation rules
   177	 * (ISO-01, ISO-02, D-04, D-06, D-07, D-37, D-38, D-40, D-41, D-66). Each entry
   178	 * reads "<schema>.<table>: <problem>", "role <name>: <problem>" or
   179	 * "allowlist: <problem>". An empty list means the schema is compliant.
   180	 *
   181	 * Run it as a superuser on a migrated database so every relation and role is
   182	 * visible. `allowlist` is a test-only override.
   183	 */
   184	export async function collectCatalogViolations(
   185	  client: pg.Client,
   186	  allowlist: Record<string, string> = CATALOG_ALLOWLIST,
   187	): Promise<string[]> {
   188	  const violations: string[] = [];
   189	
   190	  const { rows: siftRoles } = await client.query<RoleRow>(
   191	    `select rolname, rolsuper, rolbypassrls, rolcreaterole, rolcreatedb
   192	     from pg_roles where rolname = any($1::text[]) order by 1`,
   193	    [SIFT_ROLES],
   194	  );
   195	  const missing = SIFT_ROLES.filter((r) => !siftRoles.some((row) => row.rolname === r));
   196	  if (missing.length > 0) {
   197	    // The privilege functions below raise on an unknown role.
   198	    return missing.map((r) => `role ${r}: does not exist`);
   199	  }
   200	
   201	  const { rows: relations } = await client.query<RelationRow>(RELATIONS_SQL);
   202	  const { rows: policies } = await client.query<PolicyRow>(POLICIES_SQL);
   203	  const { rows: foreignKeys } = await client.query<ForeignKeyRow>(FOREIGN_KEYS_SQL);
   204	  const isScoped = (qualified: string) => !Object.hasOwn(allowlist, qualified);
   205	
   206	  violations.push(...allowlistProblems(allowlist, relations));
   207	
   208	  for (const rel of relations) {
   209	    const scoped = isScoped(rel.qualified);
   210	    if (scoped) {
   211	      violations.push(...scopedTableProblems(rel, policies));
   212	    }
   213	    violations.push(...privilegeProblems(rel, scoped));
   214	    if (rel.has_updated_at && (rel.relkind === 'r' || rel.relkind === 'p')) {
   215	      if (!rel.updated_at_trigger) {
   216	        violations.push(`${rel.qualified}: no BEFORE UPDATE row trigger calling set_updated_at()`);
   217	      }
   218	    }
   219	  }
   220	
   221	  for (const fk of foreignKeys) {
   222	    if (isScoped(fk.child) && isScoped(fk.parent) && !fk.mailbox_aligned) {
   223	      violations.push(
   224	        `${fk.child}: foreign key ${fk.conname} to ${fk.parent} does not pair mailbox_id on both sides`,
