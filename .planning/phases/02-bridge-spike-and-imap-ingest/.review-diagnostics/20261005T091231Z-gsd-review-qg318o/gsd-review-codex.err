    44	/** label and decision reference a message through (mailbox_id, message_id) (D-04). */
    45	function insertStatement(
    46	  table: ScopedTable,
    47	  mailboxId: string | null,
    48	  messageId: string,
    49	): [string, unknown[]] {
    50	  return table === 'label' || table === 'decision'
    51	    ? [`insert into ${table} (mailbox_id, message_id) values ($1, $2)`, [mailboxId, messageId]]
    52	    : [`insert into ${table} (mailbox_id) values ($1)`, [mailboxId]];
