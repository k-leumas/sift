     1	import type pg from 'pg';
     2	import { afterAll, beforeAll, describe, expect, it } from 'vitest';
     3	import { APPEND_ONLY_TABLE_NAMES, SCOPED_TABLE_NAMES } from '../src/schema/index.ts';
     4	import { connect, freshDatabase, type TestDatabase } from './support/db.ts';
     5	import { type ScopedRowIds, seedMailboxes, seedScopedRows } from './support/seed.ts';
     6	
     7	/**
     8	 * Mailbox isolation at the database level (ISO-03, success criterion 4).
     9	 * Every statement runs on a raw pg client logged in as sift_app with no
    10	 * application `WHERE mailbox_id` filter (D-46), so RLS alone decides what is
    11	 * visible. The superuser connection is used only for ground truth.
    12	 */
    13	
    14	type ScopedTable = (typeof SCOPED_TABLE_NAMES)[number];
    15	
    16	const APPEND_ONLY = new Set<string>(APPEND_ONLY_TABLE_NAMES);
    17	const MUTABLE_TABLES = SCOPED_TABLE_NAMES.filter((t) => !APPEND_ONLY.has(t));
    18	
    19	/** Children first, so a RESTRICT foreign key never masks the RLS result. */
    20	const CHILD_FIRST: readonly ScopedTable[] = [
    21	  'label',
    22	  'decision',
    23	  'message',
    24	  ...SCOPED_TABLE_NAMES.filter((t) => !['label', 'decision', 'message'].includes(t)),
    25	];
