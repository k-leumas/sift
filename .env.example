# Docker Compose interpolation variables. Copy to .env and fill in.
#
# Generate each password with:   openssl rand -hex 24
# Hex values are URL-safe, so they keep postgres:// connection URLs valid.
#
# Mailbox (IMAP) passwords belong in .env.mailboxes (copied from
# .env.mailboxes.example), never in this file. Only the worker container reads
# them.

# Image superuser. Used only inside the db service (bootstrap, healthcheck).
POSTGRES_PASSWORD=

# sift_owner: owns the sift database; runs migrate and config apply.
SIFT_DB_OWNER_PASSWORD=

# sift_backup: pg_dump only (BYPASSRLS + pg_read_all_data).
SIFT_DB_BACKUP_PASSWORD=

# sift_app: worker role. `sift migrate` creates it and rotates its password.
SIFT_DB_APP_PASSWORD=

# Host loopback port for the db service.
SIFT_DB_PORT=5432

# Optional: Node version for the image build (defaults to the .nvmrc version).
# NODE_VERSION=
