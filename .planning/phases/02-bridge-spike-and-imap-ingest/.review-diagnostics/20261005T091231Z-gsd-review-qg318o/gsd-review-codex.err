    log: SupervisorLog; now?: () => number; startedAt?: number; startupGraceMs?: number; openImap?: typeof openImap; sleep?: (ms: number) => Promise<void>;
    backfillSliceSize?: number /* tests only; defaults to the engine's BACKFILL_SLICE_SIZE */ }
  export function createMailboxCallbacks(db: AppDb, secrets: readonly string[], ingest: MailboxIngestOptions): MailboxCallbacks;
  export function createDbStore(session: IngestSession): IngestStore;   // apps/worker/src/ingest/db-store.ts
  packages/db/test/support/seed.ts: export async function seedImapMailbox(ownerUrl: string, m: { slug: string; host: string; port: number; username: string; passwordEnv: string; folder?: string }): Promise<string>;   // returns the mailbox id

Owner-facing messages (ownerMessageFor):
  pin_mismatch     `The IMAP server's certificate for mailbox <slug> does not match imap.tls.pin_sha256. If you reinstalled Bridge, run sift bridge trust <slug> to see the fingerprint the worker sees, compare it with the one docker compose run --rm bridge-init printed, and update config.yaml.`
  cert_untrusted   pinned: same as pin_mismatch; not pinned: `The IMAP server's certificate for mailbox <slug> is not trusted. For Proton Bridge, set imap.tls.pin_sha256 (shown by docker compose run --rm bridge-init and sift bridge trust <slug>).`
  auth_rejected    `Bridge rejected login: run docker compose run --rm bridge-init`
  unreachable / timeout (after grace)   `IMAP server unreachable at <host>:<port>`
  no_starttls      `IMAP server at <host>:<port> does not offer STARTTLS; Sift never logs in without TLS`
  password_missing `Missing env var: <NAME> (password_env of mailbox <slug>); add it to .env.mailboxes and recreate the worker`
  not_in_config    `mailbox <slug> is not in the config this worker loaded; recreate the worker: docker compose up -d --force-recreate worker`
</interfaces>
</context>

