<interfaces>
Scope extensions (scope.ts):
  type UniqueKey<T> = Exclude<keyof InferSelectModel<T> & string, 'mailboxId' | 'id' | 'createdAt' | 'updatedAt'>
  ScopedTableApi<T>.upsert(
    rows: readonly Omit<InferInsertModel<T>, 'mailboxId' | 'id'>[],
    options: { target: readonly UniqueKey<T>[]; update?: readonly UniqueKey<T>[] },
  ): Promise<{ id: string; inserted: boolean }[]>
    // mailbox_id is prepended to the conflict target and filled into every row; ON CONFLICT DO UPDATE sets
    // `update` columns from EXCLUDED, or a no-op assignment when `update` is empty, so RETURNING yields the
    // existing row; inserted = (xmax = 0); results come back in input order; empty input runs no SQL.
  Match<T>: each value may also be a readonly array (inArray); an empty array matches nothing and runs no SQL.
  Scope.messageBody: ScopedTableApi<typeof messageBody> & { deleteExpired(at: Date): Promise<number> }

Ingest use-cases (ingest.ts); every function takes `scope: Scope` first:
  interface AttachmentMeta { name: string | null; mimeType: string; sizeBytes: number | null }
  interface MessageInput { identityKey; messageIdHeader: string | null; internalDate: Date; sentAt: Date | null;
    fromAddress: string | null; fromDomain: string | null; subject: string | null;
    headers: Record<string, string[]>; attachments: AttachmentMeta[]; sizeBytes: number | null; eligibleForClassification: boolean }
  interface LocationInput { folder: string; uidvalidity: number; uid: number; generation: number }
  interface BodyInput { bodyText: string; source: 'text_plain' | 'text_html' | 'none'; truncated: boolean }
  interface StoreItem { message: MessageInput; location: LocationInput; body: BodyInput | null }
  interface StoreResult { insertedMessages; existingMessages; promotedMessages; insertedLocations; insertedBodies }
  storeMessages(scope, items: readonly StoreItem[], options?: { promoteEligible?: boolean }): Promise<StoreResult>
  type FolderSyncRow = InferSelectModel<typeof folderSync>
  getFolderSync(scope, folder): Promise<FolderSyncRow | null>
  interface BackfillCursor { since: Date; cursorUid: number; untilUid: number; total: number }
  createFolderSync(scope, init: { folder; uidvalidity; lastUid; internalDateWatermark: Date; backfill: BackfillCursor | null }): Promise<FolderSyncRow>
  advanceFolderSync(scope, folder, to: { lastUid?: number; internalDateWatermark?: Date; backfillCursorUid?: number }): Promise<void>   // each given value only moves forward (monotonic max)
  setFolderBackfill(scope, folder, backfill: BackfillCursor | null): Promise<void>   // start, restart (after a resync) or finish the D-75 first backfill
  interface LiveLocation { id: string; uid: number; uidvalidity: number; generation: number; messageId: string }
  liveLocations(scope, folder): Promise<LiveLocation[]>   // removed_at is null, any uidvalidity or generation
  markLocationsRemoved(scope, ids: readonly string[], reason: 'vanished' | 'superseded', at?: Date): Promise<number>
  deleteOrphanBodies(scope, messageIds: readonly string[]): Promise<number>
  knownIdentityKeys(scope, keys: readonly string[]): Promise<Map<string, { id: string; eligible: boolean }>>
  beginResync(scope, folder, pending: { pendingUidvalidity: number; pendingGeneration: number }): Promise<void>
  interface ResyncSummary { matched: number; new: number; gone: number; older: number }
  finishResync(scope, folder, done: { uidvalidity; generation; lastUid; internalDateWatermark: Date; summary: Omit<ResyncSummary, 'gone'>; at?: Date }): Promise<{ superseded: number; vanished: number; summary: ResyncSummary }>
    // persists last_resync_summary with gone = the number of distinct messages marked vanished by this call
  deleteExpiredBodies(scope, at?: Date): Promise<number>
</interfaces>
