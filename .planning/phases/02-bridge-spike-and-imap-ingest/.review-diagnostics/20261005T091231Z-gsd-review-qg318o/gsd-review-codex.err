    14	
    15	jobs:
    16	  check:
    17	    runs-on: ubuntu-24.04
    18	    timeout-minutes: 20
    19	
    20	    services:
    21	      postgres:
    22	        image: pgvector/pgvector:0.8.7-pg18-trixie
    23	        env:
    24	          POSTGRES_PASSWORD: ci-postgres-password
    25	        ports:
    26	          - 5432:5432
    27	        options: >-
    28	          --health-cmd "pg_isready -h 127.0.0.1 -U postgres"
    29	          --health-interval 5s
    30	          --health-timeout 3s
    31	          --health-retries 20
    32	
    33	    # Throwaway values for the ephemeral service container above; no production
    34	    # credential is involved (threat T-01-20, accepted).
    35	    env:
    36	      CI: 'true'
    37	      SIFT_DB_OWNER_PASSWORD: ci-owner-password
    38	      SIFT_DB_APP_PASSWORD: ci-app-password
    39	      SIFT_DB_BACKUP_PASSWORD: ci-backup-password
    40	      SIFT_TEST_ADMIN_URL: postgres://postgres:ci-postgres-password@localhost:5432/postgres
    41	
    42	    steps:
    43	      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
    44	
    45	      # Reads packageManager from package.json. Node 26 ships without corepack.
    46	      - uses: pnpm/action-setup@0977fd99725f1db4007ccb2928dbb4e90d06cc86 # v6.0.10
    47	
    48	      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
    49	        with:
    50	          node-version-file: .nvmrc
    51	          cache: pnpm
    52	
    53	      - name: Install dependencies
    54	        run: pnpm install --frozen-lockfile
    55	
    56	      # pg_dump/pg_restore must match the server major (18); the runner image
    57	      # does not ship client 18, so take it from the PGDG apt repository.
    58	      - name: Install PostgreSQL 18 client
    59	        run: |
    60	          sudo apt-get update
    61	          sudo apt-get install -y postgresql-common
    62	          sudo /usr/share/postgresql-common/pgdg/apt.postgresql.org.sh -y
    63	          sudo apt-get install -y postgresql-client-18
    64	          echo "/usr/lib/postgresql/18/bin" >> "$GITHUB_PATH"
    65	
    66	      # Same superuser bootstrap as the Compose initdb hook: roles sift_owner and
    67	      # sift_backup, database sift, extension vector in template1.
    68	      - name: Bootstrap roles and extensions
    69	        run: >-
    70	          docker exec -i -e SIFT_DB_OWNER_PASSWORD -e SIFT_DB_BACKUP_PASSWORD
    71	          ${{ job.services.postgres.id }}
    72	          psql -v ON_ERROR_STOP=1 -U postgres -f - < db/bootstrap.sql
    73	
    74	      - name: Lint
    75	        run: pnpm lint
    76	
    77	      - name: Typecheck
    78	        run: pnpm typecheck
    79	
    80	      # Includes the catalog schema check and the isolation tests; DB tests
    81	      # fail (never skip) when SIFT_TEST_ADMIN_URL is unusable.
    82	      - name: Test
    83	        run: pnpm test
    84	
