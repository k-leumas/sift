   233	 * mailbox_status is under forced RLS and the owner is subject to it (D-41),
   234	 * so each status read runs with app.mailbox_id set to that mailbox.
   235	 */
   236	export async function listMailboxes(ownerUrl: string): Promise<MailboxListing[]> {
   237	  return withOwnerClient(ownerUrl, (client) =>
   238	    inTransaction(client, async () => {
   239	      await client.query('set transaction read only');
   240	      const { rows } = await client.query<MailboxDbRow>(MAILBOX_SELECT);
   241	      const listings: MailboxListing[] = [];
   242	      for (const row of rows) {
   243	        await client.query("select set_config('app.mailbox_id', $1, true)", [row.id]);
   244	        const status = await client.query<StatusDbRow>(
   245	          `select state, last_error, last_sync_at, last_seen_at
   246	             from mailbox_status where mailbox_id = $1`,
   247	          [row.id],
   248	        );
   249	        const s = status.rows[0];
   250	        listings.push({
   251	          slug: row.slug,
   252	          displayName: row.display_name,
   253	          disabledAt: row.disabled_at,
   254	          state: s?.state ?? null,
   255	          lastSeenAt: s?.last_seen_at ?? null,
   256	          lastSyncAt: s?.last_sync_at ?? null,
   257	          lastError: s?.last_error ?? null,
   258	        });
   259	      }
