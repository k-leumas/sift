   220	  count=${count//[[:space:]]/}
   221	  [ "$count" -ge "$min" ] || fail "$label: expected >= $min, got $count"
   222	  echo "compose-smoke: $label = $count"
   223	}
   224	
   225	atleast "migrations applied" 5 "select count(*) from drizzle.__drizzle_migrations"
   226	atleast "mailboxes registered" 1 "select count(*) from mailbox"
   227	atleast "mailboxes ok" 1 "select count(*) from mailbox_status where state = 'ok'"
   228	
   229	echo "compose smoke OK"

