    88	async function readTruth(): Promise<Record<ScopedTable, Row[]>> {
    89	  const out = {} as Record<ScopedTable, Row[]>;
    90	  for (const table of SCOPED_TABLE_NAMES) {
    91	    const { rows } = await admin.query<Row>(
    92	      `select ${idColumn(table)} as id, mailbox_id, updated_at from ${table}`,
    93	    );
    94	    out[table] = rows;
    95	  }
    96	  return out;
    97	}
