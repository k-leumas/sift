   134	/**
   135	 * Identity of an IMAP mailbox (D-64), shared by the duplicate check and the
   136	 * registry's rename pairing. Values are trimmed, as the schema stores them.
   137	 * Host and username compare case-insensitively; INBOX is case-insensitive per
   138	 * RFC 3501, every other folder name is compared exactly.
   139	 */
   140	export function imapIdentityKey(host: string, username: string, folder: string): string {
   141	  const trimmedFolder = folder.trim();
   142	  const normalisedFolder = trimmedFolder.toUpperCase() === 'INBOX' ? 'INBOX' : trimmedFolder;
   143	  return JSON.stringify([
   144	    host.trim().toLowerCase(),
   145	    username.trim().toLowerCase(),
   146	    normalisedFolder,
   147	  ]);
   148	}
   149	
   150	/** imapIdentityKey of a raw (not yet parsed) config entry, or undefined. */
   151	function imapIdentity(mailbox: unknown): string | undefined {
   152	  const imap = field(mailbox, 'imap');
   153	  const host = field(imap, 'host');
   154	  const username = field(imap, 'username');
   155	  const folder = field(imap, 'folder') ?? 'INBOX';
   156	  if (typeof host !== 'string' || typeof username !== 'string' || typeof folder !== 'string') {
   157	    return undefined;
   158	  }
   159	  return imapIdentityKey(host, username, folder);
   160	}
   161	
   162	/** Slug uniqueness (D-63) and one config entry per IMAP mailbox (D-64). */
   163	function checkMailboxDuplicates(mailboxes: unknown, ctx: z.RefinementCtx): void {
   164	  if (!Array.isArray(mailboxes)) return;
   165	  const slugs = new Map<string, number>();
   166	  const accounts = new Map<string, number>();
   167	  mailboxes.forEach((mailbox: unknown, index) => {
   168	    const slug = field(mailbox, 'slug');
   169	    if (typeof slug === 'string') {
   170	      const first = slugs.get(slug);
   171	      if (first === undefined) {
   172	        slugs.set(slug, index);
   173	      } else {
   174	        ctx.addIssue({
   175	          code: 'custom',
   176	          path: [index, 'slug'],
   177	          message: `duplicate slug "${slug}" (also used by mailboxes[${first}])`,
   178	        });
   179	      }
   180	    }
   181	
   182	    const identity = imapIdentity(mailbox);
   183	    if (identity !== undefined) {
   184	      const first = accounts.get(identity);
   185	      if (first === undefined) {
   186	        accounts.set(identity, index);
   187	      } else {
   188	        const imap = field(mailbox, 'imap');
   189	        const described = [
   190	          field(imap, 'host'),
   191	          field(imap, 'username'),
   192	          field(imap, 'folder') ?? 'INBOX',
   193	        ];
   194	        ctx.addIssue({
   195	          code: 'custom',
   196	          path: [index, 'imap'],
   197	          message: `mailboxes[${first}] and mailboxes[${index}] read the same IMAP mailbox (${described.join(' ')}); this would process mail twice`,
   198	        });
   199	      }
   200	    }
   201	  });
   202	}
