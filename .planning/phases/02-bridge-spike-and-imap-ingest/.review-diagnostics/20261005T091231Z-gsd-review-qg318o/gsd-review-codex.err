   162	/**
   163	 * Dump through sift_backup, then prune old dumps (D-29, D-66). Pruning runs only
   164	 * after the new dump is complete, so a failure never shrinks the history.
   165	 */
   166	async function backupBeforeApplying(
   167	  backup: BackupTarget | false | undefined,
   168	  pending: readonly string[],
   169	  log: (line: string) => void,
   170	): Promise<string | null> {
   171	  if (backup === false) {
   172	    return null;
   173	  }
   174	  if (backup === undefined) {
   175	    throw new BackupRequiredError(
   176	      `SIFT_BACKUP_DATABASE_URL is not set; a backup is required before applying ${pending.length} pending migrations`,
   177	    );
   178	  }
   179	  const target = pending.at(-1);
   180	  if (target === undefined) {
   181	    return null;
   182	  }
   183	  await ensureWritableDir(backup.dir);
   184	  const file = await writeBackup(backup, backupFileName(new Date(), target));
   185	  const removed = await pruneBackups(backup.dir, BACKUP_KEEP);
   186	  log(`Backup written: ${path.basename(file)}`);
   187	  if (removed.length > 0) {
   188	    log(`Pruned ${removed.length} old backup(s)`);
   189	  }
   190	  return file;
   191	}
