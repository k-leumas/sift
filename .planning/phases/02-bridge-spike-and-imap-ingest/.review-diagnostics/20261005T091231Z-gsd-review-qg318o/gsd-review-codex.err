  export const TLS_MODES = ['starttls', 'implicit'] as const;            export type TlsMode = (typeof TLS_MODES)[number];
  export const PIN_SHA256_PATTERN = /^[A-Za-z0-9+/]{43}=$/;               // base64 of a 32-byte SHA-256 (D-73)
  export const DEFAULT_INITIAL_BACKFILL_DAYS = 30; MIN_INITIAL_BACKFILL_DAYS = 0; MAX_INITIAL_BACKFILL_DAYS = 365;
  export const DEFAULT_NEW_MAIL_CAP = 200;          MIN_NEW_MAIL_CAP = 1;          MAX_NEW_MAIL_CAP = 10_000;
  ImapConfig.tls: { mode: TlsMode; pin_sha256?: string }        // default { mode: 'starttls' }
  MailboxConfig.ingest: { initial_backfill_days: number; new_mail_cap: number }   // default { 30, 200 }
  WorkerConfig.poll_interval_seconds: number (unchanged)

