   193	function readJournalTags(migrationsFolder: string): string[] {
   194	  const journalPath = path.join(migrationsFolder, 'meta', '_journal.json');
   195	  const journal = JSON.parse(readFileSync(journalPath, 'utf8')) as { entries: JournalEntry[] };
   196	  return journal.entries.map((entry) => entry.tag);
   197	}
