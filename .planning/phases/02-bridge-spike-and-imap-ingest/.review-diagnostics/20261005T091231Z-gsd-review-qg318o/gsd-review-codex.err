   192	function appendOnlyTable<T extends ScopedTable>(
   193	  ctx: ScopeContext,
   194	  table: T,
   195	): AppendOnlyTableApi<T> {
   196	  const { insert, find } = scopedTable(ctx, table);
   197	  return Object.freeze({ insert, find });
   198	}
