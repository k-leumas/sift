# Host development environment. Copy to .env.development and fill in.
#
# `pnpm sift ...`, `pnpm dev` and `pnpm test` load this file automatically.
# It points host processes at the Compose db service (`docker compose up -d db`).
#
# Replace every `change-me-hex` with the SAME value as the matching password in
# .env (generated with `openssl rand -hex 24`; hex keeps the URLs valid).

# --- Database roles (passwords must equal .env) ---------------------------------

SIFT_DB_OWNER_PASSWORD=change-me-hex
# Tests share the cluster's sift_app role, and `sift migrate` rotates its
# password cluster-wide, so keep this equal to .env or a running dev worker
# loses its connection.
SIFT_DB_APP_PASSWORD=change-me-hex
SIFT_DB_BACKUP_PASSWORD=change-me-hex

# sift_owner: migrate, config apply, mailbox rename.
SIFT_OWNER_DATABASE_URL=postgres://sift_owner:change-me-hex@localhost:5432/sift
# sift_app: the worker (DML only, subject to row-level security).
SIFT_DATABASE_URL=postgres://sift_app:change-me-hex@localhost:5432/sift
# sift_backup: pg_dump before migrations (BYPASSRLS + pg_read_all_data).
SIFT_BACKUP_DATABASE_URL=postgres://sift_backup:change-me-hex@localhost:5432/sift

# Superuser URL (POSTGRES_PASSWORD from .env). Used ONLY by the test harness to
# create and drop throwaway sift_test_* databases. Never give it to the worker.
SIFT_TEST_ADMIN_URL=postgres://postgres:change-me-hex@localhost:5432/postgres

# --- Backups (D-29) ------------------------------------------------------------

# `sift migrate` writes a pg_dump here (relative to the repo root) before it
# applies pending migrations, and keeps the newest 5.
SIFT_BACKUP_DIR=backups
# The dump needs pg_dump 18. On a Mac without it, either `brew install libpq`
# (and put its bin directory on PATH), or uncomment this line to run pg_dump
# inside the Compose db container (`docker compose up -d db` must be running).
# The tests use the same setting to find pg_dump and pg_restore.
# SIFT_PG_DUMP=scripts/pg-dump-via-compose.sh

# --- Models --------------------------------------------------------------------

# Ollama on the host (the container default is host.docker.internal).
SIFT_MODELS_URL=http://localhost:11434

# --- Mailboxes (fake values) -----------------------------------------------------

# Dev-only placeholders matching the password_env names in
# config/config.example.yaml. They only satisfy the startup presence check;
# real IMAP passwords go in .env.mailboxes.
SIFT_PERSONAL_IMAP_PASSWORD=dev-placeholder
SIFT_JOBS_IMAP_PASSWORD=dev-placeholder
